// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "indent_guides": {
    "coloring": "fixed",
  },
  "auto_indent": "syntax_aware",
  "cli_default_open_behavior": "new_window",
  "minimap": {
    "show": "never",
  },
  "format_on_save": "on",
  "buffer_line_height": "comfortable",
  "relative_line_numbers": "disabled",
  "code_lens": "on",
  "colorize_brackets": false,
  "diff_view_style": "split",
  "agent_buffer_font_size": 18.0,
  "outline_panel": {
    "button": false,
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "git_panel": {
    "group_by": "staging",
    "tree_view": true,
    "dock": "left",
  },
  "inlay_hints": {
    "show_background": false,
    "enabled": true,
  },
  "soft_wrap": "editor_width",
  "which_key": {
    "delay_ms": 1000,
    "enabled": true,
  },
  "agent_ui_font_size": 20.0,
  "always_treat_brackets_as_autoclosed": true,
  "use_auto_surround": true,
  "vim": {
    "use_system_clipboard": "always",
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
  },
  "vim_mode": true,
  "audio": {
    "experimental.input_audio_device": "coreaudio:BuiltInMicrophoneDevice",
  },
  "autosave": "on_focus_change",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
    "default_model": {
      "provider": "amazon-bedrock",
      "model": "claude-haiku-4-5",
      "enable_thinking": true,
    },
    "commit_message_model": {
      "provider": "amazon-bedrock",
      "model": "claude-haiku-4-5",
    },
    "commit_message_instructions": "Return exactly one plain-text Conventional Commit line: <type>[(<scope>)]: <description>. Allowed types: feat, fix, refactor, perf, test, docs, build, ci, chore, style, revert. Scope is optional. Description is No Markdown, code fences, body, explanation, or extra text.",
    "favorite_models": [],
    "model_parameters": [],
  },
  "scrollbar": {
    "git_diff": true,
  },
  "ui_font_family": ".ZedSans",
  "project_panel": {
    "dock": "left",
  },
  "show_edit_predictions": true,
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "edit_predictions": {
    "mode": "eager",
    "provider": "copilot",
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "terminal": {
    "font_family": "JetBrainsMonoNL Nerd Font",
    "shell": "system",
    "font_size": 18.0,
    "cursor_shape": "bar",
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.6-sol"
      },
      "type": "registry",
    },
  },
  "languages": {
    "Python": {
      "show_edit_predictions": true,
      // "indent_guides": {
      //   "background_coloring": "indent_aware",
      // },
    },
    "Go": {
      "show_edit_predictions": false,
    },
  },
  "base_keymap": "Zed",
  "ui_font_size": 18.0,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
}
